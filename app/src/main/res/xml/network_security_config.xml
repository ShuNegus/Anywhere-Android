<?xml version="1.0" encoding="utf-8"?>
<!-- Cleartext only for loopback: the TURN core serves the manual VK captcha page on
     http://127.0.0.1:8765/ (spec §9, §14 #9). Everything else keeps the platform default
     (no cleartext on targetSdk 28+). -->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
